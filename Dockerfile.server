FROM python:3.11-slim

WORKDIR /app

# Salin dependensi dan instal
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Salin source code
COPY proto/ proto/
COPY generated/ generated/
COPY server/ server/
COPY client/ client/
COPY scripts/ scripts/

# Buat folder data untuk database SQLite
RUN mkdir -p data

EXPOSE 50051

CMD ["python", "-m", "server.main", "--host", "0.0.0.0", "--port", "50051", "--db", "data/cinema.db"]
